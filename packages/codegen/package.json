    "@appshape/ir": "workspace:*",
    "@appshape/protocol": "workspace:*",
    "@appshape/store": "workspace:*",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@appshape/kit": "workspace:*",
    "@appshape/render": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "vitest": "catalog:"
  }
