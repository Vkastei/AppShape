{
  "id": "n_wuubzhtymk",
  "name": "Button",
  "layout": {
    "mode": "flex",
    "direction": "row",
    "gap": "$spacing.2",
    "align": "center",
    "justify": "center",
    "padding": { "top": "$spacing.3", "right": "$spacing.4", "bottom": "$spacing.3", "left": "$spacing.4" }
  },
  "box": { "alignSelf": "start" },
  "style": {
    "background": "$color.primary",
    "color": "$color.primary-foreground",
    "radius": "$radius.md",
    "fontSize": "$fontSize.sm",
    "fontWeight": "$fontWeight.semibold",
    "cursor": "pointer"
  },
  "overrides": [
    {
      "when": { "viewport": "md" },
      "layout": {
        "padding": { "top": "$spacing.2", "right": "$spacing.4", "bottom": "$spacing.2", "left": "$spacing.4" }
      }
    },
    {
      "when": { "state": "hover" },
      "style": { "background": "$color.primary/90" }
    },
    {
      "when": {
        "prop": { "name": "variant", "value": "secondary" }
      },
      "style": { "background": "$color.secondary", "color": "$color.secondary-foreground" }
    },
    {
      "when": {
        "state": "hover",
        "prop": { "name": "variant", "value": "secondary" }
      },
      "style": { "background": "$color.secondary/80" }
    },
    {
      "when": {
        "prop": { "name": "variant", "value": "outline" }
      },
      "style": {
        "background": "$color.background",
        "color": "$color.foreground",
        "borderWidth": 1,
        "borderColor": "$color.input"
      }
    },
    {
      "when": {
        "state": "hover",
        "prop": { "name": "variant", "value": "outline" }
      },
      "style": { "background": "$color.accent", "color": "$color.accent-foreground" }
    },
    {
      "when": {
        "prop": { "name": "variant", "value": "ghost" }
      },
      "style": { "background": "transparent", "color": "$color.foreground" }
    },
    {
      "when": {
        "state": "hover",
        "prop": { "name": "variant", "value": "ghost" }
      },
      "style": { "background": "$color.accent", "color": "$color.accent-foreground" }
    },
    {
      "when": {
        "prop": { "name": "size", "value": "sm" }
      },
      "layout": {
        "gap": "$spacing.1.5",
        "padding": { "top": "$spacing.1.5", "right": "$spacing.3", "bottom": "$spacing.1.5", "left": "$spacing.3" }
      },
      "style": { "fontSize": "$fontSize.xs" }
    },
    {
      "when": {
        "viewport": "md",
        "prop": { "name": "size", "value": "sm" }
      },
      "layout": {
        "padding": { "top": "$spacing.1.5", "right": "$spacing.3", "bottom": "$spacing.1.5", "left": "$spacing.3" }
      }
    },
    {
      "when": {
        "prop": { "name": "size", "value": "lg" }
      },
      "layout": {
        "padding": { "top": "$spacing.3", "right": "$spacing.6", "bottom": "$spacing.3", "left": "$spacing.6" }
      },
      "style": { "fontSize": "$fontSize.base" }
    },
    {
      "when": {
        "viewport": "md",
        "prop": { "name": "size", "value": "lg" }
      },
      "layout": {
        "padding": { "top": "$spacing.3", "right": "$spacing.6", "bottom": "$spacing.3", "left": "$spacing.6" }
      }
    }
  ],
  "origin": "added",
  "type": "button",
  "children": [
    { "id": "n_iwr6p6soy6", "name": "Label", "origin": "added", "type": "text", "text": "Button" }
  ]
}
